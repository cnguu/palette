{
  "name": "@cnguu/palette-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "多设计调色板",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm --filter @cnguu/palette build",
