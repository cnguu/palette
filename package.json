    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@types/node": "26.1.2",
    "bumpp": "12.2.0",
    "eslint": "10.8.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
