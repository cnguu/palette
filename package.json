{
  "name": "@cnguu/palette-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "多设计规范调色板",
  "homepage": "https://github.com/cnguu/palette#readme",
  "bugs": {
    "url": "https://github.com/cnguu/palette/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cnguu/palette.git"
  },
  "license": "Apache-2.0",
  "author": "cnguu",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @cnguu/palette build",
    "dev": "pnpm --filter @cnguu/palette dev",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "play": "pnpm --filter @cnguu/palette-playground dev",
    "play:build": "pnpm --filter @cnguu/palette-playground build",
    "play:preview": "pnpm --filter @cnguu/palette-playground preview",
    "publish:core": "pnpm build && pnpm --filter @cnguu/palette publish --access public --no-git-checks",
    "release": "bumpp",
    "test": "pnpm --filter @cnguu/palette-tests test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-package-json": "catalog:",
    "lefthook": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
